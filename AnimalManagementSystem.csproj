<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="animals.txt" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="animals.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="PresentationLayer\" />
    <Compile Remove="BusinessLayer\**" />
    <Compile Remove="PresentationLayer\**" />
    <EmbeddedResource Remove="BusinessLayer\**" />
    <EmbeddedResource Remove="PresentationLayer\**" />
    <None Remove="BusinessLayer\**" />
    <None Remove="PresentationLayer\**" />
  </ItemGroup>

  <ItemGroup>
    <None Update="animals.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>